const initialState = {
  receiver: null,
  showDrawer: false,
  messages: [],
  typingUsers: {}, // usuarioId => true/false
};

const chatReducer = (state = initialState, action) => {
  switch (action.type) {
    case 'SET_ACTIVE_CHAT':
      return {
        ...state,
        receiver: action.payload,
        showDrawer: true,
        messages: [],
      };
    case 'CLOSE_CHAT_DRAWER':
      return {
        ...state,
        receiver: null,
        showDrawer: false,
        messages: [],
      };
    case 'SET_MESSAGES':
      return {
        ...state,
        messages: action.payload,
      };
    case 'ADD_MESSAGE':
      return {
        ...state,
        messages: [...state.messages, action.payload],
      };
    case 'SET_TYPING':
      return {
        ...state,
        typingUsers: {
          ...state.typingUsers,
          [action.payload.userId]: action.payload.isTyping,
        },
      };
    default:
      return state;
  }
};

export default chatReducer;
