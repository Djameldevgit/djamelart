/* ======== Estilos generales navbar ========= */
.header {
  position: sticky;
  top: 0;
  z-index: 1050;
  background-color: var(--bs-body-bg);
  box-shadow: 0 2px 8px rgba(0,0,0,0.12);
}

/* Flex container navbar */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem 1.5rem;
}

/* Logo y título */
.logo {
  display: flex;
  align-items: center;
  text-decoration: none;
  color: var(--bs-body-color);
  font-weight: 700;
  font-size: 1.6rem;
  gap: 0.6rem;
}
.logo img.imagelogo {
  width: 40px;
  height: 40px;
  object-fit: contain;
  border-radius: 6px;
}

/* Contenedor menú (links) */
.menu ul.navbar-nav {
  display: flex;
  flex-direction: row;
  list-style: none;
  margin: 0;
  padding: 0;
  gap: 1.2rem;
  align-items: center;
}

/* Cada link del navbar */
.menu ul.navbar-nav li.nav-item {
  display: flex;
  align-items: center;
}

.menu ul.navbar-nav li.nav-item .nav-link {
  display: flex;
  align-items: center;
  font-size: 1.1rem;
  color: var(--bs-body-color);
  cursor: pointer;
  padding: 0.25rem 0.5rem;
  text-decoration: none;
  transition: color 0.25s ease;
}

.menu ul.navbar-nav li.nav-item .nav-link:hover,
.menu ul.navbar-nav li.nav-item.active .nav-link {
  color: #007bff;
}

.menu ul.navbar-nav li.nav-item .nav-link .material-icons,
.menu ul.navbar-nav li.nav-item .nav-link i.fas {
  font-size: 1.4rem;
  margin-right: 0.3rem;
  line-height: 1;
}

/* Avatar en dropdown */
.navbar-nav li.nav-item.dropdown > span.nav-link {
  display: flex;
  align-items: center;
  cursor: pointer;
}

/* Dropdown menu */
.dropdown-menu {
  min-width: 180px;
  box-shadow: 0 3px 8px rgba(0,0,0,0.15);
  border-radius: 6px;
  padding: 0.4rem 0;
}

.dropdown-menu .dropdown-item {
  padding: 0.5rem 1rem;
  font-size: 1rem;
  cursor: pointer;
  color: var(--bs-body-color);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  transition: background-color 0.15s ease;
}

.dropdown-menu .dropdown-item:hover {
  background-color: #f1f1f1;
  color: #007bff;
}

/* Badge notificaciones */
 

/* ==== BOTÓN TOGGLE (hamburguesa) ==== */
.navbar-toggler {
  display: none;
  border: none;
  background: transparent;
  font-size: 1.6rem;
  cursor: pointer;
  color: var(--bs-body-color);
}
 
/* ================== ESTILOS RESPONSIVE ================== */

/* En pantallas pequeñas, ocultamos menú y mostramos toggle */
@media (max-width: 991.98px) {
  .menu ul.navbar-nav {
    display: none;
  }

  .navbar-toggler {
    display: block;
  }
}
@media (max-width: 768px) {
  .dropdown-menu {
    width: 100% !important;
    text-align: center;
  }

  .dropdown-toggle {
    width: 100%;
  }

  .dropdown-item {
    padding: 10px 20px;
  }

  .navbar .form-control {
    width: 100%;
    margin-top: 10px;
  }
}
@media (max-width: 767.98px) {
  .custom-offcanvas.offcanvas-start {
    top: 70px !important;
    height: calc(100% - 70px) !important;
  }
}
