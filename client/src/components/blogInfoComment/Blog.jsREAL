import React, { useState } from 'react';
import { useSelector, useDispatch } from 'react-redux';
import { createUserComment } from '../../redux/actions/commentUserAction.';
//import PostsPubliBlog from '../home/PostsPubliBlog'; <div className="home col-md-4" > { <PostsPubliBlog /> } </div>
  
import CommentCard from './comments/CommentCard';

const Blog = ({ user, onReply, setOnReply }) => {
  const { auth, homeUsers,socket, publiBlogReducer} = useSelector(state => state);
  const dispatch = useDispatch();
  const blog = homeUsers.length > 0 ? homeUsers[0] : { title: "Blog", comments: [] };
  const [content, setContent] = useState("");
 
 
  const handleSubmit = (e) => {
    e.preventDefault()
    if (!content.trim()) {
      if (setOnReply) return setOnReply(false)
      return
    }

    setContent('')

    const newComment = {
      content,
      likes: [],
      user: auth.user,
      createdAt: new Date().toISOString(),
      reply: onReply && onReply.commentId,
      tag: onReply && onReply.user
    }

    dispatch(createUserComment({ user, newComment, auth, socket }))

    if (setOnReply) return setOnReply(false)
  }

  return (
    <div>
      <h2>{blog.title}</h2>
      

      {auth.user && (
        <form onSubmit={handleSubmit}>
          <input
            type="text"
            placeholder="Escribe un comentario..."
            value={content}
            onChange={(e) => setContent(e.target.value)}
          />
          <button type="submit">Enviar</button>
        </form>
      )}
      {blog.comments?.length > 0
        ? blog.comments.map((comment, index) => (
            <CommentCard key={index} comment={comment} />
          ))
        : <p>No hay comentarios aún.</p>}
    </div>
  );
};


export default Blog;
