import React, { useState, useEffect, useRef, useMemo, useCallback } from 'react';
import { Card, Badge, OverlayTrigger, Tooltip } from 'react-bootstrap';
import Carousel from '../../Carousel';
import { likePost, unLikePost, savePost, unSavePost } from '../../../redux/actions/postAction';
import { buyProduct, loadCart } from '../../../redux/actions/cartAction';
import { useSelector, useDispatch } from "react-redux";
import { useTranslation } from "react-i18next";
import { Link, useHistory } from "react-router-dom";
import ShareModal from '../../ShareModal';
import VerifyModal from '../../authAndVerify/VerifyModal';
import DesactivateModal from '../../authAndVerify/DesactivateModal';
import moment from 'moment';
import Avatar from './../../Avatar';

// 🎨 Constantes de estilos
const ICON_SIZES = {
  avatar: { container: 44, image: 36 },
  action: { container: 40, icon: 22 }
};

const GRADIENTS = {
  avatar: "linear-gradient(135deg, rgba(255, 105, 180, 0.9) 0%, rgba(255, 20, 147, 0.9) 100%)",
  like: "linear-gradient(135deg, rgba(249, 24, 128, 0.9) 0%, rgba(255, 0, 110, 0.9) 100%)",
  saved: "linear-gradient(135deg, rgba(255, 140, 0, 0.9) 0%, rgba(255, 165, 0, 0.9) 100%)",
  cartAdd: "linear-gradient(135deg, rgba(76, 175, 80, 0.9) 0%, rgba(67, 160, 71, 0.9) 100%)",
  cartRemove: "linear-gradient(135deg, rgba(244, 67, 54, 0.9) 0%, rgba(229, 57, 53, 0.9) 100%)",
  share: "linear-gradient(135deg, rgba(33, 150, 243, 0.9) 0%, rgba(25, 118, 210, 0.9) 100%)",
  whatsapp: "linear-gradient(135deg, #25D366 0%, #128C7E 100%)",
  facebook: "linear-gradient(135deg, #1877F2 0%, #0d5dbd 100%)",
  twitter: "linear-gradient(135deg, #1DA1F2 0%, #0d8ecf 100%)"
};

const MESSAGES = {
  DISPLAY_DURATION: 3000
};

const CardBodyCarousel = ({ post }) => {
  const { languageReducer, auth, socket } = useSelector((state) => state);
  const dispatch = useDispatch();
  const { t } = useTranslation('cardbodycarousel');
  const history = useHistory();
  
  // Estados
  const [isLike, setIsLike] = useState(false);
  const [loadLike, setLoadLike] = useState(false);
  const [saved, setSaved] = useState(false);
  const [saveLoad, setSaveLoad] = useState(false);
  const [buyLoad, setBuyLoad] = useState(false);
  const [inCart, setInCart] = useState(false);
  const [showModal, setShowModal] = useState(false);
  const [showBuyMessage, setShowBuyMessage] = useState(false);
  const [showVerifyModal, setShowVerifyModal] = useState(false);
  const [showDeactivatedModal, setShowDeactivatedModal] = useState(false);
  const [showShareOptions, setShowShareOptions] = useState(false);
  const [isShare, setIsShare] = useState(false);
  
  const shareModalRef = useRef(null);
  const buyMessageTimerRef = useRef(null);
  
  const lang = useMemo(() => languageReducer.language || 'en', [languageReducer.language]);

  // 🔍 DEBUG: Temporal para verificar estructura del post
  useEffect(() => {
    console.log('📦 POST DATA:', {
      postId: post._id,
      user: post.user,
      userId: typeof post.user === 'object' ? post.user._id : post.user,
      images: post.images?.length,
      likes: post.likes?.length
    });
  }, [post]);

  // 🔒 Verificación de permisos optimizada
  const canProceed = useCallback(() => {
    if (!auth.token || !auth.user) {
      setShowModal(true);
      return false;
    }

    if (!auth.user.isVerified) {
      setShowVerifyModal(true);
      return false;
    }

    if (auth.user.isActive === false) {
      setShowDeactivatedModal(true);
      return false;
    }

    return true;
  }, [auth.token, auth.user]);

  // 📦 Cargar carrito al montar
  useEffect(() => {
    if (auth.token) {
      dispatch(loadCart(auth.token));
    }
  }, [auth.token, dispatch]);

  // 💖 Actualizar estado de like
  useEffect(() => {
    if (auth.user && post.likes) {
      // Manejar tanto IDs simples como objetos populados
      const userLiked = post.likes.some((like) => {
        const likeId = typeof like === 'object' ? like._id : like;
        return likeId === auth.user._id;
      });
      setIsLike(userLiked);
    } else {
      setIsLike(false);
    }
  }, [post.likes, auth.user]);

  // 🔖 Actualizar estado de guardado
  useEffect(() => {
    if (auth.user?.saved) {
      setSaved(auth.user.saved.includes(post._id));
    } else {
      setSaved(false);
    }
  }, [auth.user?.saved, post._id]);

  // 🛒 Actualizar estado del carrito
  useEffect(() => {
    const cartItems = auth.user?.cart?.items || [];
    const isInCart = cartItems.some(item => {
      const itemPostId = typeof item.postId === 'object' ? item.postId._id : item.postId;
      return itemPostId === post._id;
    });
    setInCart(isInCart);
  }, [auth.user?.cart, post._id]);

  // 🧹 Limpieza del timer al desmontar
  useEffect(() => {
    return () => {
      if (buyMessageTimerRef.current) {
        clearTimeout(buyMessageTimerRef.current);
      }
    };
  }, []);

  // 🎯 Handlers optimizados
  const handleLike = useCallback(async () => {
    if (!canProceed() || loadLike) return;
    
    setLoadLike(true);
    try {
      await dispatch(likePost({ post, auth, socket, t, languageReducer }));
    } finally {
      setLoadLike(false);
    }
  }, [canProceed, loadLike, dispatch, post, auth, socket, t, languageReducer]);

  const handleUnLike = useCallback(async () => {
    if (!canProceed() || loadLike) return;
    
    setLoadLike(true);
    try {
      await dispatch(unLikePost({ post, auth, socket, t, languageReducer }));
    } finally {
      setLoadLike(false);
    }
  }, [canProceed, loadLike, dispatch, post, auth, socket, t, languageReducer]);

  const handleSavePost = useCallback(async () => {
    if (!canProceed() || saveLoad) return;
    
    setSaveLoad(true);
    try {
      await dispatch(savePost({ post, auth }));
    } finally {
      setSaveLoad(false);
    }
  }, [canProceed, saveLoad, dispatch, post, auth]);

  const handleUnSavePost = useCallback(async () => {
    if (!canProceed() || saveLoad) return;
    
    setSaveLoad(true);
    try {
      await dispatch(unSavePost({ post, auth }));
    } finally {
      setSaveLoad(false);
    }
  }, [canProceed, saveLoad, dispatch, post, auth]);

  const handleBuyProduct = useCallback(async () => {
    if (!canProceed() || buyLoad) return;
    
    setBuyLoad(true);
    try {
      await dispatch(buyProduct({ post, auth }));
      setInCart(prev => !prev);
      await dispatch(loadCart(auth.token));
      setShowBuyMessage(true);
      
      // Limpiar timer anterior si existe
      if (buyMessageTimerRef.current) {
        clearTimeout(buyMessageTimerRef.current);
      }
      
      buyMessageTimerRef.current = setTimeout(() => {
        setShowBuyMessage(false);
        buyMessageTimerRef.current = null;
      }, MESSAGES.DISPLAY_DURATION);
    } catch (error) {
      console.error("Error al procesar compra:", error);
    } finally {
      setBuyLoad(false);
    }
  }, [canProceed, buyLoad, dispatch, post, auth]);

  const handleShare = useCallback(() => {
    if (navigator.share) {
      navigator.share({
        title: post.title || 'Mira esta publicación',
        text: post.content || 'Echa un vistazo a esta publicación',
        url: window.location.href,
      }).catch((error) => {
        if (error.name !== 'AbortError') {
          console.log('Error al compartir:', error);
        }
      });
    } else {
      setShowShareOptions(true);
    }
  }, [post.title, post.content]);

  const formatDate = useCallback((dateString) => {
    const options = { day: 'numeric', month: 'short', year: 'numeric' };
    return new Date(dateString).toLocaleDateString(
      lang === 'es' ? 'es-ES' : 'en-US', 
      options
    );
  }, [lang]);

  const handleAvatarClick = useCallback((e) => {
    e.preventDefault();
    e.stopPropagation();
    const userId = typeof post.user === 'object' ? post.user._id : post.user;
    if (userId) {
      history.push(`/profile/${userId}`);
    }
  }, [post.user, history]);

  const handlePostClick = useCallback(() => {
    history.push(`/post/${post._id}`);
  }, [history, post._id]);

  // 🎨 Componente de botón de acción reutilizable
  const ActionButton = useCallback(({ 
    icon, 
    gradient, 
    onClick, 
    isActive, 
    isLoading, 
    tooltip, 
    count, 
    placement = "left" 
  }) => (
    <OverlayTrigger placement={placement} overlay={<Tooltip>{tooltip}</Tooltip>}>
      <div style={{ display: "flex", flexDirection: "column", alignItems: "center", flexShrink: 0 }}>
        <div
          style={{
            cursor: isLoading ? "wait" : "pointer",
            background: gradient,
            borderRadius: "50%",
            padding: "8px",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            opacity: isLoading ? 0.6 : 1,
            width: `${ICON_SIZES.action.container}px`,
            height: `${ICON_SIZES.action.container}px`,
            boxShadow: `0 4px 12px ${gradient.match(/rgba\([^)]+\)/)?.[0] || 'rgba(0,0,0,0.3)'}`,
            transition: "all 0.3s ease",
            border: isActive ? "2px solid white" : "none",
            pointerEvents: isLoading ? "none" : "auto"
          }}
          onClick={onClick}
          onMouseEnter={(e) => !isLoading && (e.currentTarget.style.transform = "scale(1.1)")}
          onMouseLeave={(e) => !isLoading && (e.currentTarget.style.transform = "scale(1)")}
          role="button"
          aria-label={tooltip}
          tabIndex={0}
        >
          <span
            className="material-icons"
            style={{
              fontSize: `${ICON_SIZES.action.icon}px`,
              color: "white"
            }}
          >
            {isLoading ? "hourglass_empty" : icon}
          </span>
        </div>
        {count !== undefined && (
          <Badge
            bg="dark"
            style={{
              marginTop: "2px",
              fontSize: "10px",
              fontWeight: "600",
              padding: "2px 6px",
              borderRadius: "10px",
              backgroundColor: "rgba(0, 0, 0, 0.7)"
            }}
          >
            {count}
          </Badge>
        )}
      </div>
    </OverlayTrigger>
  ), []);

  // 🎨 Componente de opción de compartir social
  const SocialShareOption = useCallback(({ icon, label, gradient, onClick }) => (
    <div style={{ textAlign: 'center', cursor: 'pointer' }} onClick={onClick}>
      <div 
        style={{
          width: '60px',
          height: '60px',
          borderRadius: '50%',
          background: gradient,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          margin: '0 auto',
          boxShadow: `0 4px 12px ${gradient.match(/rgba\([^)]+\)/)?.[0] || 'rgba(0,0,0,0.3)'}`,
          transition: 'transform 0.2s'
        }}
        onMouseEnter={(e) => e.currentTarget.style.transform = "scale(1.1)"}
        onMouseLeave={(e) => e.currentTarget.style.transform = "scale(1)"}
      >
        <span className="material-icons" style={{ color: 'white', fontSize: '28px' }}>{icon}</span>
      </div>
      <p className="mt-2 mb-0" style={{ fontSize: '13px', fontWeight: '500' }}>{label}</p>
    </div>
  ), []);

  if (!post || !post.images || post.images.length === 0) {
    return null;
  }

  // Normalizar datos del usuario (manejar tanto ID string como objeto populado)
  const postUser = post.user || {};
  const postUserId = typeof postUser === 'object' ? postUser._id : postUser;
  const postUserName = typeof postUser === 'object' ? postUser.username : 'Usuario';
  const postUserAvatar = typeof postUser === 'object' ? postUser.avatar : null;

  return (
    <div>
      <div className="card_body">
        <div className="carousel-container" style={{
          position: "relative",
          overflow: "hidden",
          borderRadius: "12px"
        }}>
          {/* Badge de tiempo */}
          <Badge
            bg="dark"
            style={{
              position: "absolute",
              top: "12px",
              left: "12px",
              zIndex: 2,
              padding: "6px 12px",
              borderRadius: "20px",
              fontSize: "11px",
              fontWeight: "500",
              backdropFilter: "blur(10px)",
              backgroundColor: "rgba(0, 0, 0, 0.6)",
              boxShadow: "0 2px 8px rgba(0,0,0,0.3)",
              maxWidth: "calc(100% - 100px)",
              overflow: "hidden",
              textOverflow: "ellipsis",
              whiteSpace: "nowrap"
            }}
          >
            <i className='far fa-clock me-1' aria-hidden="true"></i>
            {moment(post.createdAt).fromNow()}
          </Badge>

          {/* Información del artista */}
          <div style={{
            position: "absolute",
            bottom: "0",
            left: "0",
            right: "0",
            zIndex: 2,
            color: "white",
            background: "linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 50%, transparent 100%)",
            padding: "20px 12px 12px",
            backdropFilter: "blur(8px)",
            minHeight: "80px"
          }}>
            <div style={{
              fontSize: "17px",
              fontWeight: "600",
              marginBottom: "4px",
              whiteSpace: "nowrap",
              overflow: "hidden",
              textOverflow: "ellipsis",
              textShadow: "2px 2px 4px rgba(0,0,0,0.8)"
            }}>
              {postUserName || "Artista"}
            </div>
            {post.theme && (
              <Badge
                bg="light"
                text="dark"
                style={{
                  fontSize: "12px",
                  fontWeight: "500",
                  padding: "4px 10px",
                  borderRadius: "12px",
                  maxWidth: "200px",
                  overflow: "hidden",
                  textOverflow: "ellipsis",
                  whiteSpace: "nowrap"
                }}
              >
                {post.theme}
              </Badge>
            )}
          </div>

          {/* Contenedor de iconos laterales - SIN SCROLL, HEIGHT FIJO */}
          <div style={{
            position: "absolute",
            right: "8px",
            bottom: "90px",
            top: "60px",
            zIndex: 2,
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            justifyContent: "space-evenly",
            gap: "8px",
            height: "auto",
            padding: "4px 2px"
          }}>

            {/* Avatar del usuario - CON LINK FUNCIONAL Y VALIDACIÓN */}
            {postUserId ? (
              <OverlayTrigger
                placement="left"
                overlay={<Tooltip>Ver perfil de {postUserName}</Tooltip>}
              >
                <Link 
                  to={`/profile/${postUserId}`}
                  style={{ 
                    textDecoration: 'none',
                    display: "flex",
                    flexDirection: "column",
                    alignItems: "center",
                    flexShrink: 0
                  }}
                >
                  <div
                    style={{
                      background: GRADIENTS.avatar,
                      borderRadius: "50%",
                      padding: "2px",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      width: `${ICON_SIZES.avatar.container}px`,
                      height: `${ICON_SIZES.avatar.container}px`,
                      boxShadow: "0 4px 12px rgba(255, 105, 180, 0.4)",
                      transition: "all 0.3s ease",
                      border: "2px solid white"
                    }}
                    onMouseEnter={(e) => e.currentTarget.style.transform = "scale(1.1)"}
                    onMouseLeave={(e) => e.currentTarget.style.transform = "scale(1)"}
                    role="button"
                    aria-label={`Ver perfil de ${postUserName}`}
                  >
                    <Avatar
                      src={postUserAvatar}
                      style={{
                        width: `${ICON_SIZES.avatar.image}px`,
                        height: `${ICON_SIZES.avatar.image}px`,
                        borderRadius: "50%",
                        border: "1px solid white",
                        objectFit: "cover"
                      }}
                      alt={postUserName}
                    />
                  </div>
                  <Badge
                    bg="dark"
                    style={{
                      marginTop: "4px",
                      fontSize: "10px",
                      fontWeight: "600",
                      padding: "2px 6px",
                      borderRadius: "8px",
                      backgroundColor: "rgba(0, 0, 0, 0.7)",
                      maxWidth: "50px",
                      overflow: "hidden",
                      textOverflow: "ellipsis",
                      whiteSpace: "nowrap"
                    }}
                  >
                    {postUserName?.substring(0, 8) || "User"}
                  </Badge>
                </Link>
              </OverlayTrigger>
            ) : (
              // Fallback si no hay usuario
              <div style={{
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
                flexShrink: 0,
                opacity: 0.6
              }}>
                <div
                  style={{
                    background: "rgba(128, 128, 128, 0.6)",
                    borderRadius: "50%",
                    padding: "2px",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    width: `${ICON_SIZES.avatar.container}px`,
                    height: `${ICON_SIZES.avatar.container}px`,
                    border: "2px solid white"
                  }}
                >
                  <span className="material-icons" style={{ fontSize: "24px", color: "white" }}>
                    person
                  </span>
                </div>
                <Badge
                  bg="dark"
                  style={{
                    marginTop: "4px",
                    fontSize: "10px",
                    fontWeight: "600",
                    padding: "2px 6px",
                    borderRadius: "8px",
                    backgroundColor: "rgba(0, 0, 0, 0.7)"
                  }}
                >
                  Unknown
                </Badge>
              </div>
            )}

            {/* Botón de Like */}
            <ActionButton
              icon="favorite"
              gradient={GRADIENTS.like}
              onClick={isLike ? handleUnLike : handleLike}
              isActive={isLike}
              isLoading={loadLike}
              tooltip={isLike ? 'Quitar me gusta' : 'Me gusta'}
              count={post.likes?.length || 0}
            />

            {/* Botón de Guardar */}
            <ActionButton
              icon="bookmark"
              gradient={saved ? GRADIENTS.saved : "rgba(0, 0, 0, 0.6)"}
              onClick={saved ? handleUnSavePost : handleSavePost}
              isActive={saved}
              isLoading={saveLoad}
              tooltip={saved ? 'Quitar de guardados' : 'Guardar'}
            />

            {/* Botón de Comprar */}
            <ActionButton
              icon="shopping_cart"
              gradient={inCart ? GRADIENTS.cartRemove : GRADIENTS.cartAdd}
              onClick={handleBuyProduct}
              isActive={true}
              isLoading={buyLoad}
              tooltip={inCart ? t("removeFromCart", { lng: lang }) : t("addToCart", { lng: lang })}
            />

            {/* Contador de vistas */}
            <div style={{ display: "flex", flexDirection: "column", alignItems: "center", flexShrink: 0 }}>
              <div style={{
                backgroundColor: "rgba(0, 0, 0, 0.6)",
                borderRadius: "50%",
                padding: "8px",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                width: `${ICON_SIZES.action.container}px`,
                height: `${ICON_SIZES.action.container}px`,
                boxShadow: "0 4px 12px rgba(0,0,0,0.3)"
              }}>
                <span className="material-icons" style={{ fontSize: `${ICON_SIZES.action.icon}px`, color: "white" }}>
                  visibility
                </span>
              </div>
              <Badge
                bg="dark"
                style={{
                  marginTop: "2px",
                  fontSize: "10px",
                  fontWeight: "600",
                  padding: "2px 6px",
                  borderRadius: "10px",
                  backgroundColor: "rgba(0, 0, 0, 0.7)"
                }}
              >
                {post.views || 0}
              </Badge>
            </div>

            {/* Modal de compartir (si está activo) */}
            {isShare && (
              <div className="share-modal-container" ref={shareModalRef}>
                <ShareModal
                  url={`${window.location.origin}/post/${post._id}`}
                  onClose={() => setIsShare(false)}
                />
              </div>
            )}

            {/* Botón de Compartir */}
            <ActionButton
              icon="share"
              gradient={GRADIENTS.share}
              onClick={handleShare}
              isActive={false}
              isLoading={false}
              tooltip="Compartir"
            />
          </div>

          {/* Carousel */}
          <div className="card">
            <div 
              className="card__image" 
              onClick={handlePostClick}
              style={{ cursor: 'pointer' }}
              role="button"
              tabIndex={0}
              aria-label="Ver publicación completa"
            >
              <Carousel images={post.images} id={post._id} />
            </div>
          </div>
        </div>
      </div>

      {/* Modal de opciones de compartir */}
      {showShareOptions && (
        <div 
          className="modal" 
          style={{
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            backgroundColor: 'rgba(0,0,0,0.7)',
            position: 'fixed',
            top: 0,
            left: 0,
            right: 0,
            bottom: 0,
            zIndex: 9999
          }}
          onClick={() => setShowShareOptions(false)}
        >
          <Card 
            style={{
              width: '340px',
              borderRadius: '20px',
              boxShadow: '0 10px 40px rgba(0,0,0,0.3)',
              border: 'none'
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <Card.Body className="p-4">
              <h5 className="text-center mb-4 fw-bold">Compartir publicación</h5>
              <div style={{ display: 'flex', justifyContent: 'space-around', margin: '20px 0' }}>
                <SocialShareOption
                  icon="chat"
                  label="WhatsApp"
                  gradient={GRADIENTS.whatsapp}
                  onClick={() => console.log('Compartir en WhatsApp')}
                />
                <SocialShareOption
                  icon="facebook"
                  label="Facebook"
                  gradient={GRADIENTS.facebook}
                  onClick={() => console.log('Compartir en Facebook')}
                />
                <SocialShareOption
                  icon="flutter_dash"
                  label="Twitter"
                  gradient={GRADIENTS.twitter}
                  onClick={() => console.log('Compartir en Twitter')}
                />
              </div>
              <div className="d-flex justify-content-center mt-3">
                <button
                  className="btn btn-light"
                  onClick={() => setShowShareOptions(false)}
                  style={{
                    padding: '10px 30px',
                    borderRadius: '25px',
                    fontWeight: '500',
                    border: '1px solid #ddd'
                  }}
                >
                  Cancelar
                </button>
              </div>
            </Card.Body>
          </Card>
        </div>
      )}

      {/* Modal de autenticación */}
      {showModal && (
        <div 
          className="modal" 
          style={{
            backgroundColor: 'rgba(0,0,0,0.7)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            position: 'fixed',
            top: 0,
            left: 0,
            right: 0,
            bottom: 0,
            zIndex: 9999
          }}
          onClick={() => setShowModal(false)}
        >
          <Card 
            style={{
              width: '400px',
              maxWidth: '90vw',
              borderRadius: '20px',
              boxShadow: '0 10px 40px rgba(0,0,0,0.3)',
              border: 'none',
              position: 'relative'
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <Card.Body className="p-4">
              <button
                onClick={() => setShowModal(false)}
                style={{
                  position: 'absolute',
                  top: '15px',
                  right: '15px',
                  background: 'none',
                  border: 'none',
                  fontSize: '1.8rem',
                  color: '#999',
                  cursor: 'pointer',
                  fontWeight: 'bold',
                  lineHeight: '1',
                }}
                aria-label="Cerrar"
              >
                ×
              </button>

              <h4 className="mb-3">{t("title2", { lng: lang })}</h4>
              <p className="text-muted">{t("message2", { lng: lang })}</p>
              <div className="d-flex flex-column gap-2 mt-4">
                <button
                  className="btn btn-primary"
                  onClick={() => history.push("/login")}
                  style={{ borderRadius: '10px', padding: '12px' }}
                >
                  {t("login2", { lng: lang })}
                </button>
                <button
                  className="btn btn-outline-primary"
                  onClick={() => history.push("/register")}
                  style={{ borderRadius: '10px', padding: '12px' }}
                >
                  {t("register2", { lng: lang })}
                </button>
                <button
                  className="btn btn-light"
                  onClick={() => setShowModal(false)}
                  style={{ borderRadius: '10px', padding: '12px' }}
                >
                  {t("close2", { lng: lang })}
                </button>
              </div>
            </Card.Body>
          </Card>
        </div>
      )}

      {/* Mensaje de confirmación de compra */}
      {showBuyMessage && (
        <div style={{
          position: "fixed",
          bottom: "30px",
          left: "50%",
          transform: "translateX(-50%)",
          background: inCart
            ? GRADIENTS.cartAdd
            : GRADIENTS.cartRemove,
          color: "white",
          padding: "14px 24px",
          borderRadius: "50px",
          zIndex: 9999,
          display: "flex",
          alignItems: "center",
          boxShadow: "0 6px 20px rgba(0,0,0,0.3)",
          fontWeight: "500",
          animation: "slideUp 0.3s ease-out"
        }}>
          <style>
            {`
              @keyframes slideUp {
                from {
                  transform: translateX(-50%) translateY(100px);
                  opacity: 0;
                }
                to {
                  transform: translateX(-50%) translateY(0);
                  opacity: 1;
                }
              }
            `}
          </style>
          <span className="material-icons" style={{ marginRight: "10px", fontSize: "22px" }}>
            {inCart ? "check_circle" : "shopping_cart"}
          </span>
          {inCart
            ? t("productAddedToCart", { lng: lang })
            : t("thanksForPurchase", { lng: lang })}
        </div>
      )}

      {/* Modales de verificación */}
      {showVerifyModal && (
        <VerifyModal show={showVerifyModal} onClose={() => setShowVerifyModal(false)} />
      )}
      
      <DesactivateModal 
        show={showDeactivatedModal} 
        onClose={() => setShowDeactivatedModal(false)} 
      />
    </div>
  );
};

export default React.memo(CardBodyCarousel);