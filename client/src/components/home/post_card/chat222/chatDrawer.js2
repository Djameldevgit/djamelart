// ✅ ChatDrawer.js (cliente)
import React, { useEffect, useState, useRef } from 'react';
import { Offcanvas, Form, Button, InputGroup, Image } from 'react-bootstrap';
import { BsSendFill } from 'react-icons/bs';
import { useSelector, useDispatch } from 'react-redux';
import { getDataAPI } from '../../../../utils/fetchData';
 
import axios from 'axios';
import { useTranslation } from 'react-i18next';

const ChatDrawer = () => {
  const {chat,auth,socket } = useSelector(state => state);
 
  const dispatch = useDispatch();
  const { receiver, showDrawer } = chat;

  const [conversationId, setConversationId] = useState(null);
  const [messages, setMessages] = useState([]);
  const [message, setMessage] = useState('');
  const [isTyping, setIsTyping] = useState(false);

  const scrollRef = useRef();
  const senderId = auth.user?._id;
  const receiverId = receiver?._id;
  const roomId = [senderId, receiverId].sort().join('-');

  const { t } = useTranslation('chat');

  // Emitir evento de conexión una vez
  useEffect(() => {
    if (senderId) {
      socket.emit('userConnected', senderId);
    }
  }, [senderId]);

  // Obtener o crear conversación
  useEffect(() => {
    const fetchConversation = async () => {
      if (!senderId || !receiverId) return;
      try {
        const res = await getDataAPI(`conversations/find/${senderId}/${receiverId}`, auth.token);
        setConversationId(res.data._id);
      } catch (err) {
        console.error('❌ Error al obtener conversación:', err.message);
      }
    };

    if (showDrawer && receiverId) fetchConversation();
  }, [showDrawer, receiverId, senderId, auth.token]);

  // Unirse a sala y escuchar mensajes
  useEffect(() => {
    if (!roomId) return;

    socket.emit('joinRoom', { conversationId: roomId });

    const handleReceive = (msg) => {
      if (msg.conversation === roomId) {
        setMessages(prev => [...prev, msg]);
      }
    };

    socket.on('receiveMessage', handleReceive);

    return () => {
      socket.off('receiveMessage', handleReceive);
      socket.emit('leaveRoom', { conversationId: roomId });
    };
  }, [roomId]);

  // Obtener mensajes antiguos
  useEffect(() => {
    const fetchMessages = async () => {
      if (!conversationId) return;
      try {
        const res = await getDataAPI(`messages/${conversationId}`, auth.token);
        setMessages(res.data);
      } catch (err) {
        console.error('❌ Error al obtener mensajes:', err.message);
      }
    };

    fetchMessages();
  }, [conversationId, auth.token]);

  // Escuchar typing
  useEffect(() => {
    socket.on('userTyping', ({ from }) => {
      if (from === receiverId) setIsTyping(true);
    });

    socket.on('userStoppedTyping', ({ from }) => {
      if (from === receiverId) setIsTyping(false);
    });

    return () => {
      socket.off('userTyping');
      socket.off('userStoppedTyping');
    };
  }, [receiverId]);

  // Emitir typing
  useEffect(() => {
    if (!receiverId || !senderId) return;
    if (!message.trim()) return;

    socket.emit('typing', { to: receiverId, from: senderId });

    const timeout = setTimeout(() => {
      socket.emit('stopTyping', { to: receiverId, from: senderId });
    }, 1500);

    return () => clearTimeout(timeout);
  }, [message]);

  // Enviar mensaje
  const handleSend = async () => {
    if (!message.trim() || !senderId || !receiverId || !conversationId) return;

    try {
      const res = await axios.post('/api/messages', {
        sender: senderId,
        receiver: receiverId,
        message,
        conversationId
      }, {
        headers: { Authorization: auth.token }
      });

      socket.emit('addMessage', {
        ...res.data,
        conversation: roomId
      });

      setMessages(prev => [...prev, res.data]);
      setMessage('');
    } catch (err) {
      console.error('❌ Error al enviar mensaje:', err);
    }
  };

  useEffect(() => {
    if (scrollRef.current) {
      scrollRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  }, [messages]);

  return (
    <Offcanvas show={showDrawer} onHide={() => dispatch({ type: 'CLOSE_CHAT_DRAWER' })} placement="end" style={{ width: '400px' }}>
      <Offcanvas.Header closeButton className="border-bottom">
        <div className="d-flex align-items-center">
          <Image src={receiver?.avatar || '/default-avatar.png'} roundedCircle width={40} height={40} className="me-2" alt={t('avatarAlt')} />
          <Offcanvas.Title className="mb-0">
            {receiver?.username || t('defaultUser')}
            {isTyping && <small className="ms-2 text-muted">✍️ {t('typing')}...</small>}
          </Offcanvas.Title>
        </div>
      </Offcanvas.Header>

      <Offcanvas.Body className="d-flex flex-column p-0">
        <div style={{ flex: 1, overflowY: 'auto', padding: '1rem', background: '#f5f5f5' }}>
          {messages.length === 0 ? (
            <div className="text-center text-muted mt-4">
              <p>{t('noMessages')}</p>
            </div>
          ) : (
            messages.map((msg, i) => (
              <div key={i} className={`d-flex my-2 ${msg.sender === senderId ? 'justify-content-end' : 'justify-content-start'}`}>
                <div className={`p-3 rounded-3 ${msg.sender === senderId ? 'bg-primary text-white' : 'bg-white border'}`} style={{ maxWidth: '80%' }}>
                  <p className="mb-0">{msg.message}</p>
                  <small className={`d-block text-end ${msg.sender === senderId ? 'text-white-50' : 'text-muted'}`}>
                    {new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                  </small>
                </div>
              </div>
            ))
          )}
          <div ref={scrollRef} />
        </div>

        <div className="border-top p-3 bg-white">
          <InputGroup>
            <Form.Control
              as="textarea"
              rows={1}
              placeholder={t('messagePlaceholder')}
              value={message}
              onChange={e => setMessage(e.target.value)}
              onKeyDown={e => e.key === 'Enter' && !e.shiftKey && (e.preventDefault(), handleSend())}
              style={{ resize: 'none' }}
            />
            <Button variant="primary" onClick={handleSend} disabled={!message.trim()} aria-label={t('sendButton')}>
              <BsSendFill />
            </Button>
          </InputGroup>
        </div>
      </Offcanvas.Body>
    </Offcanvas>
  );
};

export default ChatDrawer;
