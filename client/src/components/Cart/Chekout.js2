import React, { useMemo } from 'react';
import { Form, Row, Col, Alert } from 'react-bootstrap';
import Select from 'react-select';
import countryList from 'react-select-country-list';

function Chekout({ values, onChange }) {
  const countries = useMemo(() => countryList().getData(), []);

  const handleCountryChange = (selectedOption) => {
    onChange({
      target: {
        name: 'artistLocation.country',
        value: selectedOption?.label || '',
        type: 'text'
      }
    });
  };

  const handleInputChange = (field) => (e) => {
    onChange({
      target: {
        name: `artistLocation.${field}`,
        value: e.target.value,
        type: 'text'
      }
    });
  };

  const isAlgeria = () => {
    if (!values?.country) return false;
    return values.country.toLowerCase().includes('algér');
  };

  return (
    <div className="checkout-form mt-3">
      <h5>Información de Envío</h5>
      
      <Form.Group as={Row} className="mb-3">
        <Form.Label column sm={4}>País</Form.Label>
        <Col sm={8}>
          <Select
            options={countries}
            value={countries.find(c => c.label === values?.country) || null}
            onChange={handleCountryChange}
            placeholder="Selecciona un país"
            className="basic-single"
            classNamePrefix="select"
          />
        </Col>
      </Form.Group>

      {values?.country && (
        <>
          <Form.Group as={Row} className="mb-3">
            <Form.Label column sm={4}>Región/Estado</Form.Label>
            <Col sm={8}>
              <Form.Control
                type="text"
                value={values?.region || ''}
                onChange={handleInputChange('region')}
                placeholder="Ej: Cataluña"
                required
              />
            </Col>
          </Form.Group>

          <Form.Group as={Row} className="mb-3">
            <Form.Label column sm={4}>Ciudad</Form.Label>
            <Col sm={8}>
              <Form.Control
                type="text"
                value={values?.city || ''}
                onChange={handleInputChange('city')}
                placeholder="Ej: Barcelona"
                required
              />
            </Col>
          </Form.Group>

          <Form.Group as={Row} className="mb-3">
            <Form.Label column sm={4}>Código Postal</Form.Label>
            <Col sm={8}>
              <Form.Control
                type="text"
                value={values?.postalCode || ''}
                onChange={handleInputChange('postalCode')}
                placeholder="Ej: 08001"
                required
              />
            </Col>
          </Form.Group>

          <div className={`payment-info p-3 mb-3 ${isAlgeria() ? 'bg-algeria' : 'bg-international'}`}>
            <h6>{isAlgeria() ? 'Información para Argelia' : 'Información Internacional'}</h6>
            {isAlgeria() ? (
              <>
                <p>Método de pago: CCP</p>
                <p>Banco: Banco de Argelia</p>
              </>
            ) : (
              <>
                <p>Método de pago: Transferencia Bancaria</p>
                <p>Banco: Banco Internacional</p>
              </>
            )}
          </div>
        </>
      )}

      {!values?.country && (
        <Alert variant="info" className="mt-2">
          Por favor selecciona un país para continuar
        </Alert>
      )}
    </div>
  );
}

export default Chekout;