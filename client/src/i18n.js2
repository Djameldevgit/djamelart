import i18n from 'i18next';
import { initReactI18next } from 'react-i18next';
import LanguageDetector from 'i18next-browser-languagedetector';

// 1. Importaciones estáticas para el idioma por defecto (mejor rendimiento)
import frCommon from './locales/fr/common.json';
import frCategories from './locales/fr/categories.json';
import frAuth from './locales/fr/auth.json';
import frHeader from './locales/fr/header.json';
// 2. Configuración base
const DEFAULT_LANGUAGE = 'fr';
const SUPPORTED_LANGUAGES = ['fr', 'en', 'es', 'ar'];
const NAMESPACES = ['common', 'categories', 'auth', 'header'];

// 3. Recursos iniciales (idioma por defecto precargado)
const initialResources = {
  fr: {
    common: frCommon,
    categories: frCategories,
    auth: frAuth,
    header: frHeader
  }
};

// 4. Función para cargar otros idiomas dinámicamente
const loadLanguageResources = async (lang) => {
  try {
    if (lang === DEFAULT_LANGUAGE) return initialResources.fr;
    
    const [common, categories, auth,header] = await Promise.all([
      import(`./locales/${lang}/common.json`),
      import(`./locales/${lang}/categories.json`),
      import(`./locales/${lang}/auth.json`),
      import(`./locales/${lang}/header.json`)
    ]);
    
    return {
      common: common.default,
      categories: categories.default,
      auth: auth.default
    };
  } catch (error) {
    console.error(`Error loading ${lang} resources:`, error);
    return initialResources.fr; // Fallback al francés
  }
};

// 5. Inicialización de i18n
const initializeI18n = async () => {
  // Precargar el idioma actual
  const detectedLang = i18n.language || DEFAULT_LANGUAGE;
  const initialLang = SUPPORTED_LANGUAGES.includes(detectedLang) 
    ? detectedLang 
    : DEFAULT_LANGUAGE;

  const resources = {
    ...initialResources,
    [initialLang]: await loadLanguageResources(initialLang)
  };

  await i18n
    .use(LanguageDetector)
    .use(initReactI18next)
    .init({
      resources,
      fallbackLng: DEFAULT_LANGUAGE,
      supportedLngs: SUPPORTED_LANGUAGES,
      ns: NAMESPACES,
      defaultNS: 'common',
      interpolation: {
        escapeValue: false
      },
      detection: {
        order: ['querystring', 'cookie', 'localStorage', 'navigator'],
        caches: ['cookie']
      }
    });

  // Cargar otros idiomas en segundo plano
  SUPPORTED_LANGUAGES
    .filter(lang => lang !== initialLang)
    .forEach(async lang => {
      i18n.addResourceBundle(
        lang, 
        'common', 
        (await loadLanguageResources(lang)).common
      );
      // Repite para otros namespaces si es necesario
    });
};

initializeI18n().catch(console.error);

// 6. Exportación con tipos para TypeScript (opcional)
export default i18n;